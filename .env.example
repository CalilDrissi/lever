# Contentful — copy to .env.local and fill in.
#
# Production build uses the Delivery API (published only).
# Preview (local dev / Vercel) sets CONTENTFUL_PREVIEW=true to use the
# Preview API (published + drafts).

CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master

# Delivery API token (read-only, published content) — used by prod build.
CONTENTFUL_DELIVERY_TOKEN=

# Preview API token (read-only, includes drafts) — used in preview mode.
CONTENTFUL_PREVIEW_TOKEN=

# Set to "true" only in the preview environment (local dev / Vercel).
CONTENTFUL_PREVIEW=
